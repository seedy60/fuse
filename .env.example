# Fuse Configuration

# Port the server listens on
FUSE_PORT=3000

# Display name for this instance (shown in the header, page titles, and footer)
FUSE_INSTANCE_NAME=Fuse

# Maximum upload size in bytes (default: 500MB). The browser encrypts and uploads
# in streaming chunks, so uploads scale to this limit regardless of file size.
# Downloads decrypt in the browser and hold the decrypted file in memory before
# saving, so very large downloads are bounded by the recipient's available RAM.
FUSE_MAX_FILE_SIZE=524288000

# Base URL used for generating download links (no trailing slash)
FUSE_BASE_URL=http://100.113.87.96:3000

# Mount Fuse under a sub-path, e.g. "/fuse" to serve it at example.com/fuse.
# Leave empty to serve at the domain root. When set, also include the sub-path
# in FUSE_BASE_URL (e.g. https://example.com/fuse) so share links are correct.
# Works on any host or subdomain, and whether your reverse proxy forwards the
# prefix to this app or strips it.
FUSE_BASE_PATH=

# SSL/TLS - set both to enable HTTPS
FUSE_SSL_CERT=
FUSE_SSL_KEY=

# Express "trust proxy" setting. Set this when running behind a reverse proxy
# (nginx, Caddy, etc.) so rate limiters see the real client IP. Use the number
# of proxy hops (e.g. 1) or the proxy's address - NOT "true", which trusts a
# spoofable X-Forwarded-For. Leave empty when exposed directly.
FUSE_TRUST_PROXY=1

# Upload directory (relative or absolute path)
FUSE_UPLOAD_DIR=./uploads

# Minutes allowed for a request body to finish uploading (0 disables this timeout)
FUSE_UPLOAD_TIMEOUT_MINUTES=60

# Maximum encrypted bytes sent per chunked upload request (default: 32MB)
FUSE_UPLOAD_CHUNK_SIZE_BYTES=33554432

# Hours before incomplete chunked uploads are cleaned up
FUSE_CHUNK_UPLOAD_TTL_HOURS=24

# Cleanup interval in minutes (how often expired files are purged)
FUSE_CLEANUP_INTERVAL=10

# Require first-download claim code by default
FUSE_REQUIRE_CLAIM_CODE=true

# Server-side pepper for owner token hashing (set a long random value)
FUSE_TOKEN_PEPPER=change-me-to-a-long-random-secret

# Claim code brute-force protection
FUSE_CLAIM_MAX_ATTEMPTS=5
FUSE_CLAIM_WINDOW_MINUTES=15
FUSE_CLAIM_BLOCK_MINUTES=30

# --- Optional account system ---

# Server-side pepper for account authenticator lookup hashing (set a long random value)
FUSE_ACCOUNT_PEPPER=change-me-to-a-long-random-secret

# Secret used to sign account session tokens (set a long random value).
# If unset, a random secret is generated at startup and sessions reset on restart.
FUSE_SESSION_SECRET=change-me-to-a-long-random-secret

# Digits in a generated account number (minimum 16, default 20)
FUSE_ACCOUNT_NUMBER_DIGITS=20

# How long an account session stays valid, in minutes
FUSE_ACCOUNT_SESSION_TTL_MINUTES=30

# "Remember me" duration in days (0 disables the option). When a user opts in,
# their session and vault key persist in their browser's local storage this long.
FUSE_ACCOUNT_REMEMBER_DAYS=30

# Account login brute-force protection (per-IP triage)
FUSE_ACCOUNT_LOGIN_MAX_ATTEMPTS=10
FUSE_ACCOUNT_LOGIN_WINDOW_MINUTES=15
FUSE_ACCOUNT_LOGIN_BLOCK_MINUTES=30

# Max concurrent account-login verifications server-wide (caps total guess rate
# regardless of source IP; the real brute-force wall, not the per-IP limit above)
FUSE_ACCOUNT_LOGIN_MAX_CONCURRENT=4

# How many verifications may queue behind the concurrency cap before excess
# requests are shed with a 503 (prevents a memory blow-up under flood)
FUSE_ACCOUNT_LOGIN_MAX_QUEUE=20
